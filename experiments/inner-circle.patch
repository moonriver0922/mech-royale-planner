+    def _circle_waypoint(self, pos, zs):
+        """Seek an accessible interior approach if the center is behind a wall."""
+        center, radius = zs["nc"], zs["nr"]
+        nav = self.nav
+        x, y = pos[:2]
+        target_radius = radius - zs["margin"] - 4.0
+        if nav is None or target_radius < 4 or math.dist(pos[:2], center) <= target_radius:
+            return center
+        if nav.line_clear(x, y, *center):
+            return center
+        angle = math.atan2(y - center[1], x - center[0])
+        for offset in (0.0, 0.25, -0.25, 0.5, -0.5, 0.8, -0.8):
+            a = angle + offset
+            point = (center[0] + target_radius * math.cos(a), center[1] + target_radius * math.sin(a))
+            if nav.line_clear(x, y, *point):
+                return point
+        return center

